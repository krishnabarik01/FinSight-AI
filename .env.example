# FinSight AI Configuration
APP_NAME=FinSight AI
APP_VERSION=1.0.0
APP_ENV=dev
SECRET_KEY=your_secure_secret_key_here_required_for_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://finsight-ai-bvm3.onrender.com

# Frontend API Base URL (Configured in Vercel / frontend/.env.production)
# VITE_API_URL=https://finsight-ai-bvm3.onrender.com

# Supabase / PostgreSQL Configuration
# In production (APP_ENV=prod), DATABASE_URL is required. SQLite fallback is only allowed when APP_ENV=dev.
DATABASE_URL=postgresql+asyncpg://postgres:your_password_here@db.your_project_ref.supabase.co:5432/postgres
SYNC_DATABASE_URL=postgresql://postgres:your_password_here@db.your_project_ref.supabase.co:5432/postgres

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
DB_ECHO=false

# Twilio Voice Call Alert Notifications (Optional - simulated provider active when blank)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Monitoring
MONITORING_INTERVAL_SECONDS=60

# Real-Time Precious Metals API Configuration (Nebula Metals)
NEBULA_API_KEY=your_nebula_api_key_here
NEBULA_API_URL=https://workspace.nebulaapi.com
NEBULA_DEFAULT_CITY=Visakhapatnam

# Groww API Configuration (Primary stock market data provider)
GROWW_API_KEY=your_groww_api_key_here
GROWW_API_SECRET=your_groww_api_secret_here
GROWW_AUTH_TOKEN=your_groww_auth_token_here
GROWW_API_URL=https://api.groww.in/v1

# Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Cache Configuration (Optional Redis URL, defaults to in-memory cache)
REDIS_URL=
